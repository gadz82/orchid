{
  "name": "orchid-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/check-nav.ts && node scripts/generate-llms-txt.mjs && node scripts/generate-sitemap.mjs && next build && pagefind --site out --output-path public/_pagefind",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract:schema": "python scripts/extract_config_schema.py --out src/data/config-schema.json"
  },
  "dependencies": {
    "@next/mdx": "^15.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "^15.0.0",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^26.0.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4",
    "tsx": "^4.0.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
